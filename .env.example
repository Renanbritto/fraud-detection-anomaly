# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Redis Cache & Sliding Window Feature Store
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ML Hyperparameters & Cost Matrix
ISOLATION_FOREST_N_ESTIMATORS=300
ISOLATION_FOREST_WEIGHT=0.55
AUTOENCODER_WEIGHT=0.45
DEFAULT_THRESHOLD=0.65

# Cost-Sensitive Decision Loss (BRL)
COST_FALSE_POSITIVE=15.00
COST_FALSE_NEGATIVE=3500.00
